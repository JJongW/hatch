# 아이디어 · 문서를 저장할 폴더 (기본 ~/Hatch, ~는 홈 폴더. Windows도 ~/Hatch 또는 ~\Hatch)
HATCH_DATA_DIR=~/Hatch

# Tailscale Serve 주소창 호스트. npm start는 필요 없음 — npm run dev로 열 때 버튼이 막히면 넣는다
# HATCH_SERVE_HOST=my-mac.tail1234.ts.net

# claude 실행 파일 (기본 claude, .js · .mjs · .cjs 경로면 node로 실행) · 모델 (비우면 Claude Code 기본값)
# HATCH_CLAUDE_BIN=claude
# HATCH_CLAUDE_MODEL=

# 사용자 테스트 웹 설문(/survey) 저장소. 비우면 설문 화면이 제출을 막는다. 표는 supabase/survey.sql
# 비밀 키는 서버에서만 읽는다 (NEXT_PUBLIC_ 붙이지 않는다)
# SUPABASE_URL=https://<프로젝트 ID>.supabase.co
# SUPABASE_SECRET_KEY=

# 공유 링크 (#117). 맥과 Vercel에 같은 값. 32자 이상, `openssl rand -base64 32`로 만든다. 표는 supabase/shares.sql
# Vercel: HATCH_PUBLISH_TOKEN + 위 SUPABASE_* / 맥: HATCH_PUBLISH_TOKEN + HATCH_PUBLISH_URL (맥에는 Supabase 키를 두지 않는다)
# HATCH_PUBLISH_TOKEN=
# HATCH_PUBLISH_URL=https://hatch-steel-alpha.vercel.app/api/publish
